# Nur Namen, keine Werte. Die Werte setzt der Inhaber selbst in hPanel (Umgebungsvariablen), nie im Chat, nie in Dateien.
# Prüfen ohne Wert zu zeigen: grep -c '^MS_CLIENT_SECRET=' .env

# Sanity (Projektkennung ist öffentlich, ein Schlüssel wird nicht gebraucht: Preise werden beim Bau öffentlich gelesen)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Adresse der Seite (robots.txt, Sitemap). Produktion: https://bundu.ch
SITE_URL=

# Formular. Standard aus. Wirkt beim Bau (Seite) und zur Laufzeit (Route). Ein = 1
FORMULAR_AKTIV=
# Erlaubte Herkunft der Anfragen, kommagetrennt
ERLAUBTE_HERKUNFT=
# Empfänger und Absender der Mail
KONTAKT_ZIEL=
KONTAKT_ABSENDER=

# Microsoft Graph (eigene App, nur Berechtigung Mail senden, per Exchange-Richtlinie auf das Postfach beschränkt)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Nur für lokale Tests, in der Produktion nie setzen
# KONTAKT_TESTMODUS=
# GRAPH_TEST_TOKEN_URL=
# GRAPH_TEST_API_BASE=
